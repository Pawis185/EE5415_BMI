<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="20dp">

        <!-- Health Status Icon -->
        <ImageView
            android:id="@+id/report_image"
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:src="@drawable/bot_fit"
            android:layout_marginTop="20dp"
            android:contentDescription="@string/app_name" />

        <!-- BMI Value Display -->
        <TextView
            android:id="@+id/report_result"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/bmi_result"
            android:textSize="22sp"
            android:layout_marginTop="30dp" />

        <!-- Health Advice Display -->
        <TextView
            android:id="@+id/report_advice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/advice_fit"
            android:textSize="20sp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="20dp"
            android:minWidth="250dp"
            android:gravity="center"
            android:textAlignment="center" />

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#CCCCCC"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp" />

        <!-- AI Suggestion Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ai_health_suggestion"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp" />

        <!-- Loading Progress Bar -->
        <ProgressBar
            android:id="@+id/loading_progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp" />

        <!-- LLM Health Suggestion Display -->
        <TextView
            android:id="@+id/llm_suggestion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="16sp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="30dp"
            android:padding="15dp"
            android:background="@drawable/llm_suggestion_bg"
            android:gravity="start"
            android:textAlignment="textStart"
            android:lineSpacingExtra="4dp"
            android:visibility="gone" />

    </LinearLayout>
</ScrollView>