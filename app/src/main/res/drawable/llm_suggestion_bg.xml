<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 浅蓝色背景 -->
    <solid android:color="#E3F2FD"/>

    <!-- 圆角 -->
    <corners android:radius="12dp"/>

    <!-- 边框 -->
    <stroke
        android:width="1dp"
        android:color="#90CAF9"/>

    <!-- 内边距 -->
    <padding
        android:left="15dp"
        android:top="15dp"
        android:right="15dp"
        android:bottom="15dp"/>
</shape>