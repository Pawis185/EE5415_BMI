<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.example.bmi">

    <!-- ============================================= -->
    <!-- Permissions                                   -->
    <!-- ============================================= -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:allowBackup="true"
        android:icon="@drawable/icon_128"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AppCompat.Light"
        android:usesCleartextTraffic="true"
        tools:targetApi="31">

        <!-- ============================================= -->
        <!-- MVC Architecture                              -->
        <!-- ============================================= -->
        <activity
            android:name=".mvc.MainActivity"
            android:exported="true"
            android:label="@string/bmi_calculator_mvc">
        </activity>

        <activity
            android:name=".mvc.ReportActivity"
            android:exported="false"
            android:label="@string/bmi_report_mvc" />

        <!-- ============================================= -->
        <!-- MVP Architecture                              -->
        <!-- ============================================= -->
        <activity
            android:name=".mvp.view.MainMvpActivity"
            android:exported="true"
            android:label="@string/bmi_calculator_mvp">
        </activity>

        <activity
            android:name=".mvp.view.ReportMvpActivity"
            android:exported="false"
            android:label="@string/bmi_report_mvp" />

        <!-- ============================================= -->
        <!-- MVVM Architecture                             -->
        <!-- ============================================= -->
        <activity
            android:name=".mvvm.view.MainMvvmActivity"
            android:exported="true"
            android:label="@string/bmi_calculator_mvvm">
        </activity>

        <activity
            android:name=".mvvm.view.ReportMvvmActivity"
            android:exported="false"
            android:label="@string/bmi_report_mvvm" />

        <!-- ============================================= -->
        <!-- MVI Architecture (Default Launcher)           -->
        <!-- ============================================= -->
        <activity
            android:name=".mvi.view.MainMviActivity"
            android:exported="true"
            android:label="@string/bmi_calculator_mvi">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <activity
            android:name=".mvi.view.ReportMviActivity"
            android:exported="false"
            android:label="@string/bmi_report_mvi" />

        <!-- NEW: BMI History Activity -->
        <activity
            android:name=".mvi.view.BmiHistoryActivity"
            android:exported="false"
            android:label="@string/bmi_history_title"
            android:parentActivityName=".mvi.view.MainMviActivity" />

    </application>

</manifest>