<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.example.bmi">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AppCompat.Light"
        tools:targetApi="31">

        <!-- ============================================= -->
        <!-- MVC Architecture                              -->
        <!-- ============================================= -->
        <!-- Uncomment the intent-filter to use MVC as launcher -->
        <activity
            android:name=".mvc.MainActivity"
            android:exported="true"
            android:label="BMI Calculator (MVC)">

<!--            <intent-filter>-->
<!--                <action android:name="android.intent.action.MAIN" />-->
<!--                <category android:name="android.intent.category.LAUNCHER" />-->
<!--            </intent-filter>-->

        </activity>

        <activity
            android:name=".mvc.ReportActivity"
            android:exported="false"
            android:label="BMI Report (MVC)" />

        <!-- ============================================= -->
        <!-- MVP Architecture                              -->
        <!-- ============================================= -->
        <!-- Uncomment the intent-filter to use MVP as launcher -->
        <activity
            android:name=".mvp.view.MainMvpActivity"
            android:exported="true"
            android:label="BMI Calculator (MVP)">

<!--            <intent-filter>-->
<!--                <action android:name="android.intent.action.MAIN" />-->
<!--                <category android:name="android.intent.category.LAUNCHER" />-->
<!--            </intent-filter>-->

        </activity>

        <activity
            android:name=".mvp.view.ReportMvpActivity"
            android:exported="false"
            android:label="BMI Report (MVP)" />

        <!-- ============================================= -->
        <!-- MVVM Architecture                             -->
        <!-- ============================================= -->
        <!-- Uncomment the intent-filter to use MVVM as launcher -->
        <activity
            android:name=".mvvm.view.MainMvvmActivity"
            android:exported="true"
            android:label="BMI Calculator (MVVM)">

<!--            <intent-filter>-->
<!--                <action android:name="android.intent.action.MAIN" />-->
<!--                <category android:name="android.intent.category.LAUNCHER" />-->
<!--            </intent-filter>-->

        </activity>

        <activity
            android:name=".mvvm.view.ReportMvvmActivity"
            android:exported="false"
            android:label="BMI Report (MVVM)" />

        <!-- ============================================= -->
        <!-- MVI Architecture                              -->
        <!-- ============================================= -->
        <!-- Uncomment the intent-filter to use MVI as launcher -->
        <activity
            android:name=".mvi.view.MainMviActivity"
            android:exported="true"
            android:label="BMI Calculator (MVI)">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <activity
            android:name=".mvi.view.ReportMviActivity"
            android:exported="false"
            android:label="BMI Report (MVI)" />

        <!-- ============================================= -->
        <!-- Architecture Selector (Optional)              -->
        <!-- ============================================= -->
        <!-- You can create a launcher activity to choose architecture -->
        <!--
        <activity
            android:name=".ArchitectureSelectorActivity"
            android:exported="true"
            android:label="BMI Calculator">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        -->

    </application>

    <!-- ============================================= -->
    <!-- Permissions (Add if needed)                  -->
    <!-- ============================================= -->
    <!-- <uses-permission android:name="android.permission.INTERNET" /> -->
    <!-- <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" /> -->

</manifest>